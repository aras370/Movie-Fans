@page
@model Presentation.Pages.UserPanel.EditModel
@{
}



<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">@User.Identity.Name خوش آمدید</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

    </div>
</nav>
<form>



    <div class="container my-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <img src="/UsersAvatars/@User.FindFirst("AvatarName").Value" alt="Profile Picture" class="rounded-circle mr-3" width="100">
                    <div class="ms-2">
                        <h4 class="mb-0">@User.Identity.Name</h4>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container my-5">
       
       
            <div class="mb-3">
                <label for="newEmail" class="form-label">ایمیل</label>
                <input type="email" class="form-control" id="newEmail" placeholder="Enter new email">
            </div>
            
       
    </div>

    <div class="container my-5">

        <div class="mb-3">
            <label for="newPassword" class="form-label">کلمه عبور فعلی</label>
            <input type="password" class="form-control" id="newPassword">
        </div>
        
            <div class="mb-3">
                <label for="newPassword" class="form-label">کلمه عبور جدید</label>
                <input type="password" class="form-control" id="newPassword" >
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label">تکرار کلمه عبور جدید</label>
            </div>
            <button type="submit" class="btn btn-primary">ویرایش</button>
       
    </div>
</form>
