@page
@model Presentation.Pages.UserPanel.EditModel
@{
    ViewData["Title"] = "ویرایش اطلاعات کاربری";
}




<form method="post" enctype="multipart/form-data">


    <input asp-for=User.AvatarName type="hidden" class="form-control">
    <input asp-for=User.UserId type="hidden" class="form-control">


    <div class="container my-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">

                    <img id="UserAvatar" src="/UsersAvatars/@Model.User.AvatarName" alt="Profile Picture" class="rounded-circle mr-3">
                    <div class="ms-2">
                        <h4 class="mb-0">@User.Identity.Name</h4>

                    </div>
                </div>

                <input asp-for=User.UserAvatar type="file" class="mt-4 form-control" id="EditUserAvatar">

            </div>
        </div>
    </div>

    <div class="container my-5">


        <div class="mb-3">
            <label for="newEmail" class="form-label">ایمیل</label>
            <input asp-for=User.Email type="email" class="form-control" id="newEmail">
        </div>


    </div>

    <div class="container my-5">

        <button type="submit" class="btn btn-success">ذخیره</button>
        <a href="/UserPanel/Index" class="btn btn-primary">بازگشت</a>

    </div>

    <div asp-validation-summary="All" class="text-danger">
    </div>
</form>


@section Scripts{
    <script>
        function readURL(input) {

            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#UserAvatar').attr('src', e.target.result);
                }

                reader.readAsDataURL(input.files[0]);
            }
        }

        $("#EditUserAvatar").change(function () {
            readURL(this);
        });
    </script>
        }