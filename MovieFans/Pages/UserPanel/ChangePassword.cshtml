@page
@model Presentation.Pages.UserPanel.ChangePasswordModel

@using System.Security.Claims


@{
    
    
}


<form method="post">


    <input asp-for="Password.UserId" value="@User.FindFirst(ClaimTypes.NameIdentifier).Value" type="hidden" class="form-control">


  

    <div class="container my-5">



        <div class="mb-3">
            <label for="newPassword" class="form-label">کلمه عبور جدید</label>
            <input asp-for="Password.Password" autocomplete="off" class="form-control" id="newPassword">
        </div>
        <div class="mb-3">
            <label for="confirmPassword" class="form-label">تکرار کلمه عبور جدید</label>
            <input  autocomplete="off" asp-for="Password.RePassword" class="form-control" id="newPassword">

        </div>
        <button type="submit" class="btn btn-success">ذخیره</button>
        <a href="/UserPanel/Index" class="btn btn-primary">بازگشت</a>

    </div>

    <div asp-validation-summary="All" class="text-danger">
    </div>
</form>