@page
@model Presentation.Pages.UserPanel.IndexModel
@using System.Security.Claims

@{
    ViewData["Title"]= "پنل کاربری";
}

@*@{
  var email=User.FindFirst(ClaimTypes.Email).Value.ToString();
}
*@





<div class="container mt-4 bg-light">
    <div class="card bg-light">
        <div class="card-body">
            <h5 class="card-title mb-4">اطلاعات کاربری</h5>
            <p class="card-text">نام کاربری: @Model.User1.UserName</p>
            <div class="mt-3 mb-3">
                <p class="card-text">
                    عکس:

                    <img src="/UsersAvatars/@Model.User1.AvatarName" />
                </p>

            </div>


            <p class="card-text mt-2">ایمیل: @Model.User1.Email</p>
            <a asp-page="Edit" asp-route-userid="@Model.User1.UserId" class="btn btn-primary">ویرایش اطلاعات</a>
            <a asp-page="ChangePassword" asp-route-userid="@Model.User1.UserId" class="btn btn-primary">ویرایش کلمه عبور</a>
        </div>
    </div>
</div>




