@{
    ViewData["Title"] = "Home Page";
}





<h3 class="row justify-content-center">برترین ها</h3>


<!-- Top Movies Grid -->
<div class="container mt-4">
    <div class="row">
        <!-- Movie 1 -->
        <div class="col-md-3">
            <div class="card mb-4 box-shadow">
                <img class="card-img-top" src="/MoviesImages/Lord.jpg" alt="Movie 1">
                <div class="card-body">
                    <h5 class="card-title">ارباب حلقه ها</h5>
                    <p class="card-text">فیلم فانتزی بسیار عالی</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-primary">اطلاعات بیشتر</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card mb-4 box-shadow">
                <img class="card-img-top" src="/MoviesImages/a9ec542e7ad64ca98fd56e37a5321cfa.jpg" alt="Movie 2">
                <div class="card-body">
                    <h5 class="card-title">کنستانتین</h5>
                    <p class="card-text">فیلمی ماورایی</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-primary">اطلاعات بیشتر</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Movie 3 -->
        <div class="col-md-3">
            <div class="card mb-4 box-shadow">
                <img class="card-img-top w-100" src="/MoviesImages/solomonkane.jpg" alt="Movie 3">
                <div class="card-body">
                    <h5 class="card-title">سالامون کین</h5>
                    <p class="card-text">فیلمی با محتوای انتقام</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                            <button type="button" class="btn btn-sm btn-outline-primary">اطلاعات بیشتر</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Add more columns for additional movies -->
    </div>
</div>
